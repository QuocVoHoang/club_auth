ENV=development
APP_NAME=go base service
PORT=8080
LOG_LEVEL=debug
# Store the complete PEM keys as strings. In a single-line .env value, use
# literal \n between PEM lines.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-public-key\n-----END PUBLIC KEY-----"

DB_USER=base
DB_PASS=base_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=base
DB_SSL_MODE=disable

ALLOW_HOSTS=*
